# Maintainer: omastore contributors <https://github.com/antunesales-dev/omastore>

pkgname=omastore-git
pkgver=r14.2c72a7f
pkgrel=1
pkgdesc="Terminal client for limehawk/HANCORE Omarchy catalogs (not official Omarchy)"
arch=('any')
url="https://github.com/antunesales-dev/omastore"
license=('MIT')
depends=('python' 'python-textual')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
provides=("${pkgname%-git}")
conflicts=("${pkgname%-git}")
source=("git+https://github.com/antunesales-dev/omastore.git")
sha256sums=('SKIP')
install=omastore.install

pkgver() {
  cd omastore
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd omastore
  python -m build --wheel --no-isolation
}

package() {
  cd omastore
  python -m installer --destdir="$pkgdir" dist/*.whl

  # `omastore desktop` resolves share/ as parents[2]/share from desktop.py
  # (…/pythonX.Y/site-packages/omastore/desktop.py → …/pythonX.Y/share).
  local _mod _root
  _mod=$(find "$pkgdir" -type f -path '*/site-packages/omastore/desktop.py' | head -n1)
  if [[ -z $_mod ]]; then
    echo "error: installed omastore/desktop.py not found" >&2
    return 1
  fi
  _root="$(dirname "$(dirname "$(dirname "$_mod")")")"
  install -Dm644 share/applications/Omastore.desktop \
    "$_root/share/applications/Omastore.desktop"
  install -Dm644 share/icons/omastore.svg \
    "$_root/share/icons/omastore.svg"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
