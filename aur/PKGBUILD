# Maintainer: omastore contributors <https://github.com/antunesales-dev/omastore>

pkgname=omastore-git
pkgver=r14.2c72a7f
pkgrel=1
pkgdesc="Terminal client for limehawk/HANCORE Omarchy catalogs (not official Omarchy)"
arch=('any')
url="https://github.com/antunesales-dev/omastore"
license=('MIT')
# textual-image: install via pip until it is in extra/AUR
depends=('python>=3.12' 'python-textual' 'python-pillow')
optdepends=('python-textual-image: TUI screenshots (AUR, or pip install textual-image)')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
provides=("${pkgname%-git}")
conflicts=("${pkgname%-git}")
source=("git+https://github.com/antunesales-dev/omastore.git")
sha256sums=('SKIP')
install=omastore.install

pkgver() {
  cd omastore
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd omastore
  python -m build --wheel --no-isolation
}

package() {
  cd omastore
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
