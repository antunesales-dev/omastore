Screen {
    background: #111111;
    color: #e8e8e8;
}

Header {
    background: #1a1a1a;
    color: #7dcea0;
    text-style: none;
}

Footer {
    background: #1a1a1a;
}

#chrome {
    height: auto;
    padding: 0 1;
    background: #1a1a1a;
}

#brand {
    width: auto;
    height: 1;
    padding: 0 1 0 0;
    color: #7dcea0;
    text-style: bold;
}

#tabs {
    height: 1;
    padding: 0 0 0 0;
}

.tab {
    width: auto;
    padding: 0 1;
    color: #888888;
}

.tab.active {
    color: #111111;
    background: #7dcea0;
    text-style: bold;
}

#search {
    width: 1fr;
    background: #161616;
    border: none;
    padding: 0 1;
}

#search:focus {
    background: #1f1f1f;
}

#filters {
    height: 1;
    color: #888888;
    padding: 0 1;
}

#body {
    height: 1fr;
}

#list {
    height: 1fr;
    width: 40%;
    min-width: 24;
    max-width: 54;
    border: none;
    border-right: tall #2a2a2a;
    padding: 0 1 0 0;
    background: #111111;
}

#list:focus {
    border: none;
    border-right: tall #7dcea0;
}

#list > .option-list--option-highlighted {
    text-style: bold;
}

#detail {
    width: 1fr;
    padding: 1 2 1 2;
    scrollbar-gutter: stable;
}

#meta {
    height: auto;
    padding: 0 0 1 0;
    margin-bottom: 0;
}

#palette {
    height: 2;
    padding: 0 0 1 0;
    margin-bottom: 1;
}

#shot {
    width: 1fr;
    height: 18;
    min-height: 12;
    max-height: 22;
    padding: 0;
    margin: 0 0 1 0;
    overflow: hidden;
    background: transparent;
}

#readme {
    height: auto;
    padding: 1 0 2 0;
}

#status {
    height: 1;
    color: #888888;
    padding: 0 1;
    background: #1a1a1a;
}

#credits-line {
    height: 1;
    color: #666666;
    padding: 0 1;
    background: #1a1a1a;
}

#credits {
    width: 78;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: #1a1a1a;
    border: tall #7dcea0;
}

.badge {
    color: #7dcea0;
}

.muted {
    color: #888888;
}

#warning {
    color: #e0af68;
}

#confirm {
    width: 60;
    height: auto;
    padding: 2 3;
    background: #1a1a1a;
    border: tall #7dcea0;
    align: center middle;
}
